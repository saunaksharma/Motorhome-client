// Also patch Node.js (NodeSource, stays on 22.x), Caddy and PostgreSQL 17 automatically — Ubuntu's
// defaults only cover Ubuntu's own packages. needrestart then restarts the site / web server / database.
Unattended-Upgrade::Origins-Pattern {
	"origin=. nodistro,codename=nodistro";
	"origin=cloudsmith/caddy/stable";
	"origin=apt.postgresql.org";
};
