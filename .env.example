DATABASE_URI="postgresql://user:password@host/db?sslmode=require"
PAYLOAD_SECRET=generate_a_long_random_string

# App origin — used to lock CORS/CSRF. In production set to your live domain.
SERVER_URL="http://localhost:3000"

# Email (optional — leave blank and emails are just logged to the console).
# Needed for: new-enquiry alerts + "forgot password" emails.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<a Google "App password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
